#include <iostream>
#include <print>
#include <cmath>

using namespace std;

int main() {
    double a0, ak, Da;
    println("Введите начальное значение a0, конечное ak и шаг Da:");
    cin >> a0 >> ak >> Da;

    if (Da <= 0 || a0 > ak) {
        println("введены некорректные данные.");
        return 0;
    }

    println("{:^15}{:^15}{:^15}", "a", "V", "S");

    for (double a = a0; a <= ak + 1e-9; a += Da) {
        double V = a * a * a;
        double S = 4 * a * a;
        println("{:^15.2f}{:^15.2f}{:^15.2f}", a, V, S);
    }

    return 0;
}




#include <iostream>
#include <print>
#include <cmath>

using namespace std;

int main() {
    double a0, ak, Da;
    std::print("Введите начальное значение a0, конечное ak и шаг Da:\n");
    cin >> a0 >> ak >> Da;

    if (Da <= 0 || a0 > ak) {
        std::print("введены некорректные данные.\n");
        return 0;
    }

    std::print("{:^15}{:^15}{:^15}\n", "a", "V", "S");

    for (double a = a0; a <= ak + 1e-9; a += Da) {
        double V = a * a * a;
        double S = 4 * a * a;
        std::print("{:^15.2f}{:^15.2f}{:^15.2f}\n", a, V, S);
    }

    return 0;
}