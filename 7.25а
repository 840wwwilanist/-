#include <iostream>
#include <print>

using namespace std;

int main() {
    int n;
    cin >> n;

    print("i |");
    for (int i = 0; i <= n; i++) {
        print(" {} |", i);
    }
    println();

    print("U |");
    int a = 0, b = 1;
    for (int i = 0; i <= n; i++) {
        print(" {} |", a); 
        int c = a + b;     
        a = b;
        b = c;
    }
    println();

    return 0;
}