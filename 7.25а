#include <iostream>
#include <print>

using namespace std;

int main() {
    int n;
    print("Введите n: ");
    cin >> n;

    print("i |"); 
    for (int i = 0; i <= n; i++) {
        print(" {} |", i); 
    }
    println(); 

    print("U |");
    
    int u0 = 0;
    int u1 = 1;
    
    print(" {} |", u0); 
    
    if (n >= 1) {
        print(" {} |", u1); 
    }

    for (int i = 2; i <= n; i++) {
        int u2 = u0 + u1; 
        print(" {} |", u2); 
        
        u0 = u1; 
        u1 = u2; 
    }
    println(); 

    return 0;
}