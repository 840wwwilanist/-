#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Введите n: ";
    cin >> n;

    int u0 = 0, u1 = 1;

    cout << "Введённое число: n = " << n << "\n";
    cout << "i\tU\n";
    cout << "0\t" << u0 << "\n";
    if (n >= 1) {
        cout << "1\t" << u1 << "\n";
    }

    for (int i = 2; i <= n; i++) {
        int u = u0 + u1;
        cout << i << "\t" << u << "\n";
        u0 = u1;
        u1 = u;
    }
}
