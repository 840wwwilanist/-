#include <iostream>
#include <print>

using namespace std;

int main() {
    double x0, xk, Dx;
    cin >> x0 >> xk >> Dx;

    for (double a = x0; a <= xk + 1e-9; a += Dx) {
        double result;

        if (a < 0.0) {
            result = -a;
        }
        else if (a < 1.0) {
            result = a;
        }
        else if (a <= 2.0) {
            result = 1.0;
        }
        else {
            double x1 = 2.0, y1 = 1.0;
            double x2 = 3.0, y2 = -1.0;
            double k = (y2 - y1) / (x2 - x1);
            double b = y1 - k * x1;
            result = k * a + b;
        }

        println("{:.2f} | {:.2f}", a, result);
    }

    return 0;
}