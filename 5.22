#include <iostream>
#include <print>

using namespace std;

int main() {
    double x1, y1, x2, y2, x3, y3;
    println("Введите координаты трёх вершин треугольника (6 чисел):");
    println("x1 y1 x2 y2 x3 y3 — через пробел");
    cin >> x1 >> y1 >> x2 >> y2 >> x3 >> y3;

    double c1 = x1 * y2 - y1 * x2;
    double c2 = x2 * y3 - y2 * x3;
    double c3 = x3 * y1 - y3 * x1;

    if ((c1 >= 0 && c2 >= 0 && c3 >= 0) ||
        (c1 <= 0 && c2 <= 0 && c3 <= 0)) {
        println("Принадлежит");
    } else {
        println("Не принадлежит");
    }
}