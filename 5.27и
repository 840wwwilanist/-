#include <iostream>
#include <print>

using namespace std;

int main() {
    double x, y;
    println("Введите координаты точки (x y):");
    cin >> x >> y;

    bool shtr = (y <= 2 * x + 3) &&
                (y <= -x / 2 + 0.5) &&
                (y >= (x - 1) / 3);

    if (shtr) {
        println("Точка принадлежит заштрихованной части плоскости.");
    }
    else {
        println("Точка не принадлежит заштрихованной части плоскости.");
    }
}