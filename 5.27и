#include <iostream>
using namespace std;

int main() {
    double x{}, y{};
    cin >> x >> y;

    bool inside =
        y <= 2 * x + 3 &&
        y <= -x / 2 + 0.5 &&
        y >= (x - 1) / 3;

    cout << "Исходные данные: x = " << x << ", y = " << y << "\n";

    if (inside) {
        cout << "Точка принадлежит заштрихованной части плоскости.\n";
    }
    else {
        cout << "Точка не принадлежит заштрихованной части плоскости.\n";
    }
}
