#include <iostream>
#include <print>

using namespace std;

int main() {
    // 1. Координаты вершин с графика
    double xA = -1, yA = 1;
    double xB = 1,  yB = 0;   
    double xC = -2, yC = -1;

    // 2. Нахождение прямых по формуле y = kx + b
    // k = (y2 - y1) / (x2 - x1)
    // CA:
    double k1 = (yA - yC) / (xA - xC); 
    double b1 = yA - k1 * xA;

    // AB: 
    double k2 = (yB - yA) / (xB - xA);
    double b2 = yB - k2 * xB;

    // СВ:
    double k3 = (yB - yC) / (xB - xC);
    double b3 = yB - k3 * xB;

    double x, y;
    println("Введите x и y: ");
    cin >> x >> y;

    // 3. Подставляем x в найденные прямые
    bool cond1 = (y <= k1 * x + b1);
    bool cond2 = (y <= k2 * x + b2);
    bool cond3 = (y >= k3 * x + b3);

    if (cond1 && cond2 && cond3) {
        println("Принадлежит");
    } else {
        println("Не принадлежит");
    }

    return 0;
}