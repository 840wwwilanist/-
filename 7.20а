#include <iostream>
#include <print>

using namespace std;

int main() {
    double eps;
    println("Введите точность:");
    cin >> eps;

    double sum = 0.0;

    for (int i = 1; ; i++) {
        double term = 1.0 / (i * i);
        if (term < eps) {
            break; 
        }
        sum += term;
    }

    println("Результат: {:.5f}", sum);
    return 0;
}