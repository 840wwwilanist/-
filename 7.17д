#include <iostream>
#include <print>
#include <cmath>

using namespace std;

int main() {
    int n;
    double x;
    
    println("Введите натуральное число n и действительное число x:");
    cin >> n >> x;

    if (n <= 0) {
        println("введены некорректные данные.");
        return 0;
    }

    double product = 1.0;

    // k остается целым, но мы прибавляем 1.0, чтобы деление стало дробным
    for (int k = 1; k <= n; k = k + 1) {
        double fraction = k / (k + 1.0); 
        double cos_val = pow(cos(fabs(x)), k);
        product = product * (fraction - cos_val);
    }

    println("Результат: {}", product);

    return 0;
}