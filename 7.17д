#include <iostream>
#include <print>
#include <cmath>

using namespace std;

int main() {
    int n;
    double x;
    
    println("Введите натуральное число n и действительное число x:");
    cin >> n >> x;

    if (n <= 0) {
        println("введены некорректные данные.");
        return 0;
    }

    double res = 1.0;

    for (int k = 1; k <= n; k++) {
        double fraction = k / (k + 1.0);
        double cospow = pow(cos(fabs(x)), k);
        res *= (fraction - cospow);
    }

    println("Результат: {}", res);

    return 0;
}