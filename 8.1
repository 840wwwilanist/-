#include <iostream>
#include <print>

using namespace std;

int main() {
    long long n;
    print("Введите n: ");
    cin >> n;

    long long S = 0;

    for (long long i = 1; i <= n; i++) {
        
        long long val = i * i * i - 3 * i * n * n;
        
        if (val % 3 == 0 && val % 2 != 0) {
            S += val;
        }
    }

    println("S = {}", S);

    return 0;
}