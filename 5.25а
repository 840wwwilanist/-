#include <iostream>

using namespace std;

int main() {
    double a, res;
    println("Веедите число для переменной a:");
    cin >> a;

    if (a >= -2.0 && a < 2.0) {
        res = a * a;
    }
    else {
        res = 4;
    }

    println("Исходные данные: a = {} ", a)
    print("Результат: {}", res)
}
