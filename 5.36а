#include <iostream>
using namespace std;

int main() {
    int n{};
    cout << "Исходные данные: ";
    cin >> n;

    if (n < 0 || n > 9999) {
        cout << "Исходные данные: n = " << n << "\n";
        cout << "введены некорректные данные.\n";
        return 0;
    }

    int d4 = n / 1000;
    int d3 = (n / 100) % 10;
    int d2 = (n / 10) % 10;
    int d1 = n % 10;

    cout << "Исходные данные: n = " << n << "\n";

    if (d4 == d1 && d3 == d2) {
        cout << "число является палиндромом.\n";
    } else {
        cout << "число не является палиндромом.\n";
    }
}
