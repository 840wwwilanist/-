#include <iostream>
#include <print>

using namespace std;

int main() {
    int n;
    print("Введите количество чисел n: ");
    cin >> n;

    if (n <= 0) {
        println("Ошибка! Количество чисел n должно быть натуральным.");
        return 1;
    }

    double S = 0.0;

    print("Введите {} чисел через пробел: ", n);

    for (int i = 1; i <= n; ++i) {
        double a; 
        cin >> a; 
        
        // Если i нечётное — прибавляем, если чётное — вычитаем
        if (i % 2 != 0) {
            S += a;
        } else {
            S -= a;
        }
    }

    println("S = {}", S);

    return 0;
}