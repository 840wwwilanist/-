#include <iostream>
#include <print>
#include <cmath> 

using namespace std;

int main() {
    double x0, xk, Dx;
    println("Введите начальное значение x0, конечное xk и шаг Dx:");
    cin >> x0 >> xk >> Dx;

    if (Dx <= 0 || x0 > xk) {
        println("введены некорректные данные.");
        return 0;
    }

    println("x\ty");

    for (double x = x0; x <= xk; x = x + Dx) {
        double y;

        if (x <= 0) {
            y = 0;
        } else if (x > 0 && x <= 1) {
            y = x;
        } else {
            y = pow(x, 4); 
        }

        println("{}\t{}", x, y);
    }

    return 0;
}