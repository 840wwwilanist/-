#include <iostream>
#include <print>

using namespace std;

int main() {
    int n;
    println("Введите натуральное число n:");
    cin >> n;

    if (n <= 0) {
        println("введены некорректные данные.");
        return 0;
    }

    // Переменная для результата (начинаем с 1)
    long long fact = 1;

    // Обычный цикл, где мы вручную прибавляем 1 к i
    for (int i = 1; i <= n; i = i + 1) {
        fact = fact * i;
    }

    println("Результат: {}", fact);

    return 0;
}