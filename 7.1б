#include <iostream>
#include <print>

using namespace std;

int main() {
    int n;
    println("Введите натуральное число n:");
    cin >> n;

    if (n <= 0) {
        println("введены некорректные данные.");
        return 0;
    }

    long long fact = 1;

    for (int i = 1; i <= n; i++) {
        fact *= i;
    }

    println("Результат: {}", fact);

    return 0;
}


#include <iostream>
#include <boost/multiprecision/cpp_int.hpp>

using namespace std;
using namespace boost::multiprecision;

int main() {
    int n;
    
    cout << "Введите натуральное число n: ";
    cin >> n;

    if (n <= 0) {
        cout << "Введены некорректные данные.\n";
        return 0;
    }

    cpp_int fact = 1;

    for (int i = 1; i <= n; i++) {
        fact *= i;
    }

    cout << "Результат: " << fact << "\n"; 

    return 0;
}