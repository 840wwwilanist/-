#include <iostream>
#include <print>

using namespace std;

int main() {
    int a, b, r, s;
    println("Введите через пробел: делимое a, делитель b, первый остаток r, второй остаток s");
    cin >> a >> b >> r >> s;

    int ost = a % b;

    if (ost == 0) {
        int chastnoe = a / b;
        println("Число {} делится на {} нацело, частное = {}", a, b, chastnoe);
        return 0;
    }

    bool verno = (ost == r) || (ost == s);
    
    if (verno) {
        println("Ожидаемый результат: верно, остаток равен {}", ost);
    } else {
        println("Ожидаемый результат: не верно, остаток не равен {}, ни {}", r, s);
    }
}