#include <iostream>
#include <print>

using namespace std;

int main() {
    int a, b, r, s;
    println("Введите через пробел: делимое a, делитель b, первый остаток r, второй остаток s");
    cin >> a >> b >> r >> s;

    int ost = a % b;
    bool ok = (rem == r) || (rem == s);

    if (ok) {
        println("Ожидаемый результат: верно, остаток равен {}", ost);
    } else {
        println("Ожидаемый результат: не верно, остаток не равен {}, ни {}", r, s);
    }
}