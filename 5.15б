#include <iostream>
#include <print>

using namespace std;

int main() {
    double x, y, z;
    println("Введите три стороны треугольника (x y z):");
    cin >> x >> y >> z;

    if (!((x + y > z) && (x + z > y) && (y + z > x))) {
        println("Треугольник не существует.");
    } else {
        println("Исходные данные: x = {}, y = {}, z = {}", x, y, z);

        if ((x * x + y * y > z * z) &&
            (x * x + z * z > y * y) &&
            (y * y + z * z > x * x)) {
            println("Треугольник существует и он остроуголен.");
        } else {
            println("Треугольник существует и он не остроуголен.");
        }
    }
}