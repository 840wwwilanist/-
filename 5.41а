#include <iostream>
#include <print>

using namespace std;

int main() {
    int k, l, m, n;
    println("Введите координаты двух полей шахматной доски (k l m n):");
    cin >> k >> l >> m >> n;

    bool onecolor = ((k + l) % 2) == ((m + n) % 2);

    if (onecolor) {
        println("Ожидаемый результат: поля одного цвета.");
    } else {
        println("Ожидаемый результат: поля разных цветов.");
    }
}