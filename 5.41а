#include <iostream>
#include <print>

using namespace std;

int main() {
    int k, l, m, n;
    cin >> k >> l >> m >> n;

    // Проверка, что координаты в пределах доски (от 1 до 8)
    if (k < 1 || k > 8 || l < 1 || l > 8 || m < 1 || m > 8 || n < 1 || n > 8) {
        println("введены некорректные данные.");
        return 0;
    }

    // Сравниваем четность сумм координат
    bool onecolor = ((k + l) % 2) == ((m + n) % 2);

    if (onecolor) {
        println("поля одного цвета.");
    } else {
        println("поля разных цветов.");
    }

    return 0;
}