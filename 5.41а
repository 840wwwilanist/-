#include <iostream>
#include <print>

using namespace std;

int main() {
    // x1, y1 - координаты первой клетки (вертикаль, горизонталь)
    // x2, y2 - координаты второй клетки (вертикаль, горизонталь)
    int x1, y1, x2, y2;
    
    // Пользователь вводит 4 числа по порядку
    cin >> x1 >> y1 >> x2 >> y2;

    // Проверка: координаты не должны выходить за пределы доски 8x8
    if (x1 < 1 || x1 > 8 || y1 < 1 || y1 > 8 || 
        x2 < 1 || x2 > 8 || y2 < 1 || y2 > 8) {
        println("введены некорректные данные.");
        return 0;
    }

    // Проверяем цвет: сравниваем чётность суммы координат первой и второй клетки
    if ((x1 + y1) % 2 == (x2 + y2) % 2) {
        println("поля одного цвета.");
    } else {
        println("поля разных цветов.");
    }

    return 0;
}