#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x = 1.0;
    double y = 2.0;
    double z = 3.0;

    double a = (sqrt(abs(x - 1)) - pow(abs(y), 1.0/3.0)) / (1 + (x*x)/2 + (y*y)/4);
    double b = x * (atan(z) + exp(-(x + 3)));

    cout << "a = " << a << endl;
    cout << "b = " << b << endl;

    return 0;
}
