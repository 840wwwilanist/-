#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x = -4.5;
    double y = 2.0;

    double z = (abs(x) - abs(y)) / (1 + abs(x * y));

    cout << "x = " << x << ", y = " << y << endl;
    cout << "z = (|x| - |y|) / (1 + |x * y|)" << endl;
    cout << "z = " << z << endl;

    return 0;
}
